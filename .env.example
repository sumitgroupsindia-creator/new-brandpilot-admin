# Tenant this build targets.
VITE_TENANT_SLUG=default

# Backend base URL. The API has no global route prefix, so point this at its
# root. Leave it EMPTY only if the API is reachable at /api on this app's own
# origin (i.e. something in front rewrites /api/* to the backend).
#
# This is inlined into the JS bundle at BUILD time, not read at runtime — set
# it in your host's build environment and rebuild whenever it changes.
#
# Cross-origin requires the backend's WEB_APP_URL to equal this app's origin;
# it drives the CORS allowlist and requests are sent with credentials.
VITE_API_BASE_URL=https://api2.sumitgroups.com

# Dev only: where `pnpm dev` proxies /api. Defaults to http://localhost:3000
# DEV_API_TARGET=http://localhost:3000
