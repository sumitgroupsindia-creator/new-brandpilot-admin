# Tenant this build targets.
VITE_TENANT_SLUG=default

# Backend base URL.
# Leave EMPTY when the API is served from the same origin as this app
# (the dev proxy and the nginx config both map /api -> backend).
# Set it when the backend lives on a different host, e.g.
#   VITE_API_BASE_URL=https://api.example.com
# In that case the backend's WEB_APP_URL must equal this app's origin,
# because it drives the CORS allowlist.
VITE_API_BASE_URL=

# Dev only: where `pnpm dev` proxies /api. Defaults to http://localhost:3000
# DEV_API_TARGET=http://localhost:3000
